# ---- Core app / security ----
# Random secret used to sign Flask sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_MASTER_KEY=change-this-to-a-long-random-secret

HOST=0.0.0.0
PORT=5000
DEBUG=false

# Public base URL of this app, used to build links in emails (e.g. verification links)
APP_BASE_URL=http://localhost:5000

# ---- Database ----
# DB_TYPE = sqlite | mysql
DB_TYPE=sqlite

# Used when DB_TYPE=sqlite
DB_PATH=uptime_monitor.db

# Used when DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=uptime_user
DB_PASSWORD=uptime_pass
DB_NAME=uptime_monitor

# ---- Mail (SMTP) ----
# Used for account verification emails and monitor up/down notifications.
# Example values below are for Gmail (use an App Password, not your normal password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# ---- Monitor checker ----
# How often (seconds) the background loop wakes up to see which monitors are due for a check.
# Keep this small (5-10s) so per-monitor intervals are respected accurately.
CHECK_TICK_SECONDS=5

# How long (seconds) to wait for a monitor's URL to respond before marking it down.
REQUEST_TIMEOUT_SECONDS=10
